<Window
    x:Class="FlashCap.Wpf.Views.CaptureDeviceControlsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Camera controls" Width="320" Height="560">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <!-- Camera controls the device offers. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Controls}" Margin="12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right"
                                      Content="Auto"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding SupportsAuto, Converter={StaticResource Visible}}"
                                      IsChecked="{Binding IsAuto, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text="{Binding Value, Mode=OneWay}" Foreground="Gray" />
                            </TextBlock>
                        </DockPanel>
                        <!-- A slider for a range of values. -->
                        <Slider Visibility="{Binding IsSlider, Converter={StaticResource Visible}}"
                                Minimum="{Binding Minimum}"
                                Maximum="{Binding Maximum}"
                                SmallChange="{Binding Step}"
                                IsMoveToPointEnabled="True"
                                IsEnabled="{Binding IsManual}"
                                Value="{Binding Value, Mode=TwoWay}" />
                        <!-- A check box for a control which is on or off. -->
                        <CheckBox Visibility="{Binding IsSwitch, Converter={StaticResource Visible}}"
                                  Content="On"
                                  IsEnabled="{Binding IsManual}"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}" />
                        <!-- A choice for named values. -->
                        <ComboBox Visibility="{Binding IsChoice, Converter={StaticResource Visible}}"
                                  IsEnabled="{Binding IsManual}"
                                  ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding Choice, Mode=TwoWay}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
