<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>FlashCap.Core.Tests</AssemblyName>
    <RootNamespace>FlashCap.Core.AotSmoke</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104</WarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlashCap" Version="[$(FlashCapPackageVersion)]" />
    <PackageReference Include="FlashCap.Core" Version="[$(FlashCapPackageVersion)]" />
  </ItemGroup>

  <Target Name="RequireFlashCapPackageVersion" BeforeTargets="CollectPackageReferences"
          Condition="'$(FlashCapPackageVersion)' == ''">
    <Error Text="FlashCapPackageVersion must specify the generated FlashCap package version." />
  </Target>

</Project>
