<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;net40;net45;net461;net48;netstandard1.3;netstandard2.0;netstandard2.1;netcoreapp2.0;netcoreapp2.1;netcoreapp2.2;netcoreapp3.0;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NETSDK1215</NoWarn>
    <IsPackable>false</IsPackable>
    <OutputType Condition="'$(TargetFramework)' == 'net35' Or
                           '$(TargetFramework)' == 'net40' Or
                           '$(TargetFramework)' == 'net45' Or
                           '$(TargetFramework)' == 'net461' Or
                           '$(TargetFramework)' == 'net48'">Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlashCap.Core" Version="[$(FlashCapPackageVersion)]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="RequireFlashCapPackageVersion" BeforeTargets="CollectPackageReferences"
          Condition="'$(FlashCapPackageVersion)' == ''">
    <Error Text="FlashCapPackageVersion must specify the generated FlashCap.Core package version." />
  </Target>

</Project>
